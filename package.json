{
  "name": "giggle-photos",
  "version": "0.1.3",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "export PROJECT_ROOT=$PWD && cd apps/desktop && bun run dev",
    "start": "turbo run build && bun run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "test": "turbo run test",
    "test:e2e": "PROJECT_ROOT=$PWD DOTENV_ENV=test playwright test",
    "test:all": "turbo run test && bun run test:e2e",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean; rm -rf node_modules .turbo; bun install",
    "build:canary": "cd apps/desktop && bun run build:canary",
    "build:stable": "cd apps/desktop && bun run build:stable"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/bun": "^1.3.9",
    "@types/node": "^22.10.2",
    "turbo": "^2.8.6"
  },
  "packageManager": "bun@1.1.0",
  "engines": {
    "bun": ">=1.0.0"
  }
}
