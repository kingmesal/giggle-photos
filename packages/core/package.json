    "onnxruntime-node": "1.31.1",
    "p-queue": "^9.1.0",
    "sharp": "^0.34.5",
    "tslog": "^4.10.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "^1.3.9",
    "typescript": "^5.9.3"
  }
