    "format:check": "biome format ."
  },
  "dependencies": {
    "@giggle-photos/core": "workspace:*",
    "@tanstack/react-virtual": "3.14.26",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@happy-dom/global-registrator": "21.0.4",
    "@testing-library/react": "16.3.3",
    "@types/bun": "^1.3.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "typescript": "^5.9.3"
  }
}
