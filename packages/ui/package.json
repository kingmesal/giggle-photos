    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@giggle-photos/core": "workspace:*",
    "lucide": "1.72.0",
    "sigment": "1.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "^1.3.9",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  }
}
