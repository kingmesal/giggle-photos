{
  "name": "@giggle-photos/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electrobun dev",
    "build": "electrobun build",
    "build:canary": "electrobun build --env=canary",
    "build:stable": "electrobun build --env=stable",
    "test": "LOG_LEVEL=off bun test",
    "typecheck": "electrobun prepare --env=dev > /dev/null && tsc --build",
    "clean": "rm -rf dist node_modules .turbo build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.52.0",
    "@giggle-photos/core": "workspace:*",
    "@giggle-photos/ui": "workspace:*",
    "electrobun": "2.0.6",
    "sharp": "^0.34.5",
    "sharp-phash": "^2.2.0",
    "sigment": "1.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "^1.3.9",
    "typescript": "^5.9.3"
  }
}
