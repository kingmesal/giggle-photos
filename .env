# =============================================================================
# Environment Variables — Giggle Photos App
# =============================================================================
# Copy this file to .env.local for local development overrides.
# dotenvx loads: .env.{DOTENV_ENV}.local → .env.{DOTENV_ENV} → .env.local → .env
# Variable expansion is supported: ${PROJECT_ROOT}, ${HOME}, etc.

# -----------------------------------------------------------------------------
# Project Root (set by npm scripts, available for variable expansion)
# -----------------------------------------------------------------------------
# PROJECT_ROOT is set automatically by the dev/start scripts to the directory
# where you ran the command. Use it in other vars like APP_DATA_PATH.
# Do not set this manually in .env files.

# -----------------------------------------------------------------------------
# App Data Path
# -----------------------------------------------------------------------------
# Base directory for all app data (database, config, logs).
# Defaults to the OS-specific app data directory:
#   - Linux:   $XDG_DATA_HOME/giggle-photos  (or ~/.local/share/giggle-photos)
#   - macOS:   ~/Library/Application Support/giggle-photos
#   - Windows: %LOCALAPPDATA%\giggle-photos
# Use ${PROJECT_ROOT} for paths relative to the project:
# APP_DATA_PATH=${PROJECT_ROOT}/.app-dev

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Full path to the SQLite database file.
# Defaults to APP_DATA_PATH/app.db.
# Only set this if you need the database in a different location than APP_DATA_PATH.
# DATABASE_PATH=/custom/path/to/app.db

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Log verbosity level.
# Options: off, trace, debug, info, warn, error
# Use "debug" during development for detailed window events and RPC logs.
LOG_LEVEL=warn

# -----------------------------------------------------------------------------
# Scanning
# -----------------------------------------------------------------------------
# Number of files to process per batch during filesystem scanning. Defaults to 10.
# SCAN_BATCH_SIZE=10

# -----------------------------------------------------------------------------
# Image analysis
# -----------------------------------------------------------------------------
# Memory (MB) the image-analysis worker may hold in concurrent decodes: estimated
# as file size + width x height x channels per image. A single image larger than
# the budget still decodes, alone. Defaults to 1024.
# DECODE_MEMORY_BUDGET_MB=1024

# -----------------------------------------------------------------------------
# Hashing
# -----------------------------------------------------------------------------
# Hash algorithm used for file deduplication checksums. Defaults to sha256.
# HASH_ALGORITHM=sha256

# -----------------------------------------------------------------------------
# Release / Auto-Update (build-time only)
# -----------------------------------------------------------------------------
# Base URL where release artifacts are hosted. Used by the Electrobun updater
# to check for and download updates. Only relevant when building release builds.
# RELEASE_BASE_URL=https://github.com/kingmesal/giggle-photos/releases/latest/download
